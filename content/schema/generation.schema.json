{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lawai.academy/schemas/generation.schema.json",
  "title": "Generation Blueprint Schema",
  "description": "AI Course Generation Contract — Season 4",
  "type": "object",
  "required": ["request", "course", "subjects"],
  "properties": {
    "request": {
      "type": "object",
      "required": ["topic"],
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "goal": { "type": "string" },
        "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "adaptive"] },
        "preferredDuration": { "type": "integer", "minimum": 1 },
        "sessionLength": { "type": "integer", "minimum": 5 },
        "style": { "type": "string", "enum": ["practical", "theoretical", "mixed"] },
        "includeProjects": { "type": "boolean", "default": true },
        "includePractice": { "type": "boolean", "default": true },
        "includeFlashcards": { "type": "boolean", "default": true },
        "includeNotes": { "type": "boolean", "default": true },
        "includeVideo": { "type": "boolean", "default": true }
      }
    },
    "course": {
      "type": "object",
      "required": ["id", "title", "schoolId"],
      "properties": {
        "id": { "type": "string", "pattern": "^course-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "schoolId": { "type": "string", "pattern": "^school-[a-z]+$" },
        "estimatedHours": { "type": "integer", "minimum": 0 },
        "learningObjectives": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "recommendedTools": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "courseId"],
        "properties": {
          "id": { "type": "string", "pattern": "^subject-[a-z0-9-]+$" },
          "courseId": { "type": "string", "pattern": "^course-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "objectives": { "type": "array", "items": { "type": "string" } },
          "lessons": { "type": "array", "items": { "type": "object" } },
          "difficultyRange": {
            "type": "object",
            "properties": {
              "min": { "type": "string", "enum": ["foundation", "beginner", "intermediate", "advanced", "expert"] },
              "max": { "type": "string", "enum": ["foundation", "beginner", "intermediate", "advanced", "expert"] }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generated": { "type": "boolean", "default": true },
        "generator": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "generatorVersion": { "type": "string" },
        "sourceRequest": { "type": "string" },
        "provenance": {
          "type": "object",
          "properties": {
            "source": { "type": "string", "enum": ["ai", "manual", "imported"] },
            "model": { "type": "string" },
            "provider": { "type": "string" },
            "reviewStatus": { "type": "string", "enum": ["pending", "approved", "rejected", "published"] }
          }
        }
      }
    }
  }
}
